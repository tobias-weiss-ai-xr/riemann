}

@article{hils2024langweiltype,
  title = {Lang-Weil Type Estimates in Finite Difference Fields},
  author = {Martin Hils and Ehud Hrushovski and Jinhe Ye and Tingxiang Zou},
  year = {2024},
  url = {https://arxiv.org/abs/2406.00880v1},
