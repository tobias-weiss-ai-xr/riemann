}

@article{kenison2025onthegrowth,
  title = {On the growth of hypergeometric sequences},
  author = {George Kenison and Jakub Konieczny and Florian Luca and Andrew Scoones and Mahsa Shirmohammadi},
  year = {2025},
  url = {https://arxiv.org/abs/2507.22437v1},
