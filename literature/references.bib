}

@article{kisin2025stronglycompatiblesy,
  title = {Strongly compatible systems associated to semistable abelian varieties},
  author = {Mark Kisin and Rong Zhou},
  year = {2025},
  url = {https://arxiv.org/abs/2505.02165v1},
