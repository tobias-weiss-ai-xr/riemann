}

@article{nastasescu2023avisualperspective,
  title = {A visual perspective on the Birch and Swinnerton-Dyer conjecture through a family of approximations of $L$-functions},
  author = {Maria Nastasescu and Bogdan Stoica and Alexandru Zaharescu},
  year = {2023},
  url = {https://arxiv.org/abs/2311.07641v1},
