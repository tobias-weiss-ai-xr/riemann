}

@article{karakikes2025anarithmetictopology,
  title = {An Arithmetic Topology viewpoint on Descent theory and Equivariant Categories},
  author = {Miltiadis Karakikes and Sotiris Karanikolopoulos and Aristides Kontogeorgis and Dimitrios Noulas},
