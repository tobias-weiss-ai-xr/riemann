}

@article{balkanova2018mixedmomentof,
  title = {Mixed moment of $GL(2)$ and $GL(3)$ $L$-functions},
  author = {Olga Balkanova and Gautami Bhowmik and Dmitry Frolenkov and Nicole Raulf},
