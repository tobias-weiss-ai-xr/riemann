}

@article{yakubovich2014newsummationand,
  title = {New summation and transformation formulas of the Poisson, Müntz, Möbius and Voronoi type},
  author = {Semyon Yakubovich},
  year = {2014},
  url = {https://arxiv.org/abs/1410.7934v3},
  abstract = {Basing on properties of the Mellin transform and Ramanujan's identities, which represent a ratio of products of Riemann's zeta- functions of different arguments in terms of the Dirichlet series of arithmetic functions, we obtain a number of the Poisson, Müntz, Möbius and Voronoi type summation formulas. The corresponding analogs of the Müntz operators are investigated. Interesting and curious particular cases of summation formulas involving arithmetic functions are exhibited. Necessary and suffi},
}

@article{bradley2005seriesaccelerationfo,
