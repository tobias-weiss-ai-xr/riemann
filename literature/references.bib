}

@article{hu2025thecubicmoment,
  title = {The cubic moment of $L$-functions for specified local component families},
  author = {Yueke Hu and Ian Petrow and Matthew P. Young},
  year = {2025},
  url = {https://arxiv.org/abs/2506.14741v2},
