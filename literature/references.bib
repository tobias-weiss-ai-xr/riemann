}

@article{linn2024boundsforkloosterman,
  title = {Bounds for Kloosterman Sums for $\mathrm\{GL\}\_n$},
  author = {Johannes Linn},
  year = {2024},
  url = {https://arxiv.org/abs/2412.04976v2},
