}

@article{che2022friableaveragesof,
  title = {Friable averages of oscillating multiplicative functions},
  author = {Régis de la Bretèche and Gérald Tenenbaum},
  year = {2022},
  url = {https://arxiv.org/abs/2207.04777v14},
