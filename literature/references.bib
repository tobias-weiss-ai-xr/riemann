  url = {https://arxiv.org/abs/2602.19779v3},
  abstract = {We give a new proof of the Carlitz-Wan conjecture, previously proved by Lenstra (1995). The proof we present uses Weil's Conjecture for curves over finite fields and a result of Bombieri and Katz.},
}

@article{chen2024corankarithmetic,
