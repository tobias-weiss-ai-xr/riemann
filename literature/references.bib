}

@article{burns2023onweilstark,
  title = {On Weil-Stark elements, II: refined Stark conjectures},
  author = {David Burns and Daniel Macias Castillo and Soogil Seo},
  year = {2023},
  url = {https://arxiv.org/abs/2310.10581v1},
  abstract = {The theory of Weil-Stark elements is used to develop an axiomatic approach to the formulation of refined versions of Stark's Conjecture. This gives concrete new results concerning leading terms of Artin $L$-series and arithmetic properties of Stark elements.},
}

@article{shiga2025infinitelymanypairs,
  title = {Infinitely many pairs of non-isomorphic elliptic curves sharing the same BSD invariants},
  author = {Asuka Shiga},
