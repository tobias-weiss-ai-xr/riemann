}

@article{humphries2026rankinselbergsubconv,
  title = {Rankin--Selberg Subconvexity via Spectral Reciprocity},
  author = {Peter Humphries and Liyang Yang},
  year = {2026},
  url = {https://arxiv.org/abs/2606.11451v1},
