}

@article{kerr2024zerosofl,
  title = {Zeros of $L$-functions and large partial sums of Dirichlet coefficients},
  author = {Bryce Kerr and Oleksiy Klurman and Jesse Thorner},
  year = {2024},
  url = {https://arxiv.org/abs/2408.03938v1},
