}

@article{andersen2022hybridsubconvexityan,
  title = {Hybrid subconvexity and the partition function},
  author = {Nickolas Andersen and Han Wu},
  year = {2022},
  url = {https://arxiv.org/abs/2204.14196v1},
  abstract = {We give an upper bound for the error term in the Hardy-Ramanujan-Rademacher formula for the partition function. The main input is a new hybrid subconvexity bound for the central value $L(\tfrac 12,f\times (\tfrac\{q\}\{\cdot\}))$ in the $q$ and spectral parameter aspects, where $f$ is a Hecke-Maass cusp form for $Γ\_0(N)$ and $q$ is a fundamental discriminant.},
}

@article{blomer2016epsteinzetafunctions,
