}

@article{balkanova2018primegeodesictheorem,
  title = {Prime geodesic theorem for the Picard manifold},
  author = {Olga Balkanova and Dmitry Frolenkov},
  year = {2018},
  url = {https://arxiv.org/abs/1804.00275v3},
